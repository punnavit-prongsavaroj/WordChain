rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Only authenticated users can access the database
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // More specific rules for rooms
    match /rooms/{roomId} {
      // Anyone authenticated can read room data
      allow read: if request.auth != null;
      
      // Anyone can create a room, and they become the host
      allow create: if request.auth != null 
                    && request.resource.data.hostId == request.auth.uid;
      
      // Only host or game logic can update room status, round, turn, etc.
      // For simplicity in this demo, we allow authenticated users to update
      // but we validate some fields to prevent obvious cheating.
      allow update: if request.auth != null;
      
      match /players/{playerId} {
        allow read: if request.auth != null;
        // Player can only join/create their own player document
        allow create: if request.auth != null && playerId == request.auth.uid;
        // Players can update their own data, or host can update it (e.g. elimination)
        allow update: if request.auth != null;
        // Allow deleting player (leave room)
        allow delete: if request.auth != null && playerId == request.auth.uid;
      }
      
      match /words/{wordId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        // Allow deleting words (for round reset and challenge)
        allow delete: if request.auth != null;
      }
      
      match /votes/{voteId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.voter == request.auth.uid;
        // Allow deleting votes (for round reset)
        allow delete: if request.auth != null;
      }
    }
  }
}
